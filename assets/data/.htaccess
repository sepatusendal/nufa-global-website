# Data internal (akun karyawan, metadata memo) tidak boleh bisa dibuka lewat web.
# PHP membaca file-file ini lewat filesystem, jadi blok HTTP aman buat panel
# admin dan portal karyawan. articles.json & events.json sengaja tetap publik
# karena di-fetch langsung oleh halaman Berita & Event.
<FilesMatch "^(employees|memos)\.json(\..*)?$|\.tmp$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
