RewriteEngine On

# Canonical host: force https + www so Google sees one URL per page instead of
# 4 duplicates (http/https x non-www/www) splitting ranking signals.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^nufaglobaledu\.com$ [NC]
RewriteRule ^ https://www.nufaglobaledu.com%{REQUEST_URI} [R=301,L]

# Canonical redirect: /about.html -> /about (so links/search engines settle on one clean URL)
RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Serve the matching .html file for a clean, extension-less URL request
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^.]+)$ $1.html [NC,L]

# Cache control tuned for a site that's still actively being updated.
# HTML always revalidates so content changes show up immediately.
# CSS/JS get a short cache so styling/script fixes don't get stuck on visitors' browsers for days.
# Images/video get a longer cache since they change rarely and are heavier to re-download.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 hour"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType video/mp4 "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(html|json)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
